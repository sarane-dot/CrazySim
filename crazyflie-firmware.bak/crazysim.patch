+unsigned long ulGetRunTimeCounterValue(void)
+{
+    return 0;
+}
+
+void vConfigureTimerForRunTimeStats(void)
+{
+    return;
+}
+
+/* For memory management */
+void vApplicationMallocFailedHook(void)
+{
+    while(1);
+}
